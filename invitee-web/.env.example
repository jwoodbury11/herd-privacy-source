# Explicit deployment boundary. Production is fail-closed and requires the
# signed confidential-evaluator path. Use `test` only in an isolated QA
# project with a different database, origin, keys, and secrets.
HERD_DEPLOYMENT_PROFILE=production

# Live phone verification.
HERD_AUTH_PEPPER=replace-with-at-least-32-random-characters
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace-with-twilio-api-key-secret
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# One-time event invitation delivery. The API key above is reused to
# authenticate Twilio's Messages API. Invitation links always use this
# configured public origin rather than an untrusted request Host header.
HERD_PUBLIC_APP_URL=https://herd.example.com
HERD_IOS_APP_ID=R4UPN8ZDV8.com.herd.host
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Confidential-evaluator release pins. The three evaluator-epoch P-256 keys are
# distinct and rotate only with the epoch; the distinct response-transparency
# key is lifetime-global for herd-response-log-v1. Public keys are canonical unpadded base64url
# encodings of 65-byte uncompressed SEC1 points (04 || X || Y). The workload
# image digest is both the frozen evaluator measurement and the hardware-
# attested container image.
HERD_ARTIFACT_RELEASE_ID=2026.08.02.1
HERD_RELEASE_ID=herd-evaluator-production-2026-08-02
HERD_EVALUATOR_KEY_EPOCH_SHA256=replace-with-signed-64-lowercase-hex-epoch-descriptor-digest
HERD_EVALUATOR_KEY_ID=herd-response-decryption-production-2026-08-02
HERD_EVALUATOR_PUBLIC_KEY=replace-with-65-byte-p256-public-key-base64url
HERD_EVALUATOR_RESULT_SIGNING_KEY_ID=herd-result-signing-production-2026-08-02
HERD_EVALUATOR_RESULT_SIGNING_PUBLIC_KEY=replace-with-distinct-65-byte-p256-public-key-base64url
HERD_EVALUATOR_POLICY_SIGNING_KEY_ID=herd-policy-signing-production-2026-08-02
HERD_EVALUATOR_POLICY_SIGNING_PUBLIC_KEY=replace-with-distinct-65-byte-p256-public-key-base64url
HERD_EVALUATOR_TRANSPARENCY_SIGNING_KEY_ID=herd-transparency-signing-production-2026-08-02
HERD_EVALUATOR_TRANSPARENCY_SIGNING_PUBLIC_KEY=replace-with-distinct-65-byte-p256-public-key-base64url
HERD_EVALUATOR_MEASUREMENT=sha256:replace-with-64-lowercase-hex-image-digest

# The browser relays a fixed-size opaque evaluation request to this exact path.
# Its HMAC capability is sealed into that request; the bearer token remains
# backend-only and also authenticates policy, transparency, and attestation
# requests. The evaluator private keys never belong in this application.
HERD_EVALUATOR_TRANSPORT=client_relay
HERD_EVALUATOR_URL=https://evaluator.example.com/api/v1/relay/
HERD_EVALUATOR_TOKEN=replace-with-at-least-32-random-characters
# Optional when the evaluator is hosted as an owner-only Sites project.
# HERD_EVALUATOR_SITES_BYPASS_TOKEN=replace-with-sites-bypass-token
# An isolated QA deployment may instead sign policy and transparency proofs in
# its own Worker when the hosting platform forbids Worker-to-Worker routing.
# This is rejected by the production profile. These keys never decrypt replies.
# HERD_SOFTWARE_QA_LOCAL_TRUST_SIGNER_ENABLED=false
# HERD_EVALUATOR_POLICY_SIGNING_PRIVATE_KEY_JWK=replace-with-p256-private-jwk
# HERD_EVALUATOR_TRANSPARENCY_SIGNING_PRIVATE_KEY_JWK=replace-with-distinct-p256-private-jwk
# Optional explicit override; otherwise the same evaluator origin and this
# exact path are derived automatically.
# HERD_ATTESTATION_URL=https://evaluator.example.com/api/v1/attestation

# Optional protected scheduler/courier endpoints for resolving events when the
# hosting platform cannot use the Worker's native Cron Trigger. This credential
# can claim, complete, and release evaluation leases; keep it role-specific.
# HERD_SCHEDULER_TOKEN=replace-with-a-distinct-url-safe-random-secret

# Public values baked into the browser release. Copy them from the signed
# release manifest; never type a second, independent set by hand.
NEXT_PUBLIC_HERD_ARTIFACT_RELEASE_ID=2026.08.02.1
NEXT_PUBLIC_HERD_RELEASE_ID=herd-evaluator-production-2026-08-02
NEXT_PUBLIC_HERD_EVALUATOR_KEY_ID=herd-response-decryption-production-2026-08-02
NEXT_PUBLIC_HERD_EVALUATOR_PUBLIC_KEY=replace-with-the-same-response-decryption-public-key
NEXT_PUBLIC_HERD_EVALUATOR_RESULT_SIGNING_KEY_ID=herd-result-signing-production-2026-08-02
NEXT_PUBLIC_HERD_EVALUATOR_RESULT_SIGNING_PUBLIC_KEY=replace-with-the-same-result-signing-public-key
NEXT_PUBLIC_HERD_EVALUATOR_POLICY_SIGNING_KEY_ID=herd-policy-signing-production-2026-08-02
NEXT_PUBLIC_HERD_EVALUATOR_POLICY_SIGNING_PUBLIC_KEY=replace-with-the-same-policy-signing-public-key
NEXT_PUBLIC_HERD_EVALUATOR_TRANSPARENCY_SIGNING_KEY_ID=herd-transparency-signing-production-2026-08-02
NEXT_PUBLIC_HERD_EVALUATOR_TRANSPARENCY_SIGNING_PUBLIC_KEY=replace-with-the-same-transparency-signing-public-key

# A separately compiled, isolated QA browser release may use the reference
# software evaluator while still requiring exact signed policy/key/measurement
# pins. Production builds must omit this setting or set it to false.
NEXT_PUBLIC_HERD_DEPLOYMENT_PROFILE=production
NEXT_PUBLIC_HERD_ALLOW_SOFTWARE_QA_EVALUATOR=false
NEXT_PUBLIC_HERD_EVALUATOR_MEASUREMENT=sha256:replace-with-the-same-64-lowercase-hex-image-digest

# Google Confidential Space PKI attestation policy. Pin the exact official root
# DER fingerprint and PEM certificate recorded in the signed release evidence,
# plus the measured project, service account, image digest, and approved OS
# versions. Encode PEM newlines as `\n` in a one-line environment value.
NEXT_PUBLIC_HERD_ATTESTATION_AUDIENCE=https://herd.example.com/evaluator-attestation/v1
NEXT_PUBLIC_HERD_ATTESTATION_PROJECT_ID=replace-with-workload-project-id
NEXT_PUBLIC_HERD_ATTESTATION_SERVICE_ACCOUNT=replace-with-workload-service-account
NEXT_PUBLIC_HERD_ATTESTATION_IMAGE_DIGEST=sha256:replace-with-the-same-64-lowercase-hex-image-digest
NEXT_PUBLIC_HERD_ATTESTATION_ROOT_FINGERPRINT=replace-with-64-lowercase-hex-root-der-sha256
NEXT_PUBLIC_HERD_ATTESTATION_ROOT_CERTIFICATE=-----BEGIN CERTIFICATE-----\nreplace-with-pinned-google-confidential-space-root\n-----END CERTIFICATE-----
NEXT_PUBLIC_HERD_ATTESTATION_SWVERSIONS=replace-with-approved-version-list
NEXT_PUBLIC_HERD_ATTESTATION_MAX_AGE_SECONDS=300

# Optional, short-lived isolated-test-deployment bypass. Both flags and a fresh, unique
# generation are required so stale QA sessions cannot survive a bypass rotation.
# Generate a new UUID every time the bypass is enabled; never reuse an old value.
# These values are rejected by the production deployment profile. Never attach
# a production database, origin, evaluator release, or secrets to a test build.
# HERD_TEST_BYPASS_ENABLED=false
# HERD_ALLOW_INSECURE_QA_BYPASS=false
# HERD_QA_BYPASS_GENERATION=replace-with-a-new-random-uuid
# HERD_TEST_PHONE_E164=+14155550187
# HERD_TEST_HOST_PHONE_E164=+14155550111
# Optional destructive reset for the isolated QA database only. It additionally
# requires the test deployment profile, both bypass acknowledgements, scheduler
# bearer authorization, and an exact request-body confirmation. Never set it in
# production or attach the QA deployment to production data.
# HERD_QA_RESET_ENABLED=false

# Optional hardening/timing overrides.
# HERD_CHALLENGE_TTL_SECONDS=600
# HERD_RESEND_SECONDS=60
# HERD_MAX_CODE_ATTEMPTS=5
# HERD_PHONE_REQUESTS_PER_HOUR=5
# HERD_IP_REQUESTS_PER_HOUR=30
# HERD_SESSION_TTL_SECONDS=2592000
