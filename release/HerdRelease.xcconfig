// Herd Release builds are intentionally unusable until a signed production
// manifest has generated the configuration included below. These defaults let
// developers compile the Release target without silently contacting preview or
// test services; the production artifact preflight rejects every default.
CURRENT_PROJECT_VERSION = 0
HERD_API_BASE_URL = https:/$()/configuration.invalid
HERD_ASSOCIATED_DOMAIN = configuration.invalid
HERD_APP_CLIP_BUNDLE_IDENTIFIER = configuration.invalid.Herd.Clip
HERD_PARENT_BUNDLE_IDENTIFIER = configuration.invalid.Herd
HERD_ARTIFACT_RELEASE_ID =
HERD_ATTESTATION_AUDIENCE =
HERD_ATTESTATION_IMAGE_DIGEST =
HERD_ATTESTATION_IMAGE_DIGESTS =
HERD_ATTESTATION_MAX_AGE_SECONDS =
HERD_ATTESTATION_PROJECT_ID =
HERD_ATTESTATION_ROOT_CERTIFICATE_BASE64 =
HERD_ATTESTATION_ROOT_FINGERPRINT =
HERD_ATTESTATION_SERVICE_ACCOUNT =
HERD_ATTESTATION_SWVERSIONS =
HERD_EVALUATOR_KEY_ID =
HERD_EVALUATOR_MEASUREMENT =
HERD_EVALUATOR_POLICY_SIGNING_KEY_ID =
HERD_EVALUATOR_POLICY_SIGNING_PUBLIC_KEY =
HERD_EVALUATOR_PUBLIC_KEY =
HERD_EVALUATOR_RESULT_SIGNING_KEY_ID =
HERD_EVALUATOR_RESULT_SIGNING_PUBLIC_KEY =
HERD_EVALUATOR_TRANSPARENCY_SIGNING_KEY_ID =
HERD_EVALUATOR_TRANSPARENCY_SIGNING_PUBLIC_KEY =
HERD_RELEASE_CONFIGURATION_SHA256 =
HERD_RELEASE_ID =
MARKETING_VERSION = 0.0.0
PRODUCT_BUNDLE_IDENTIFIER = configuration.invalid.Herd

#include? "generated/HerdRelease.generated.xcconfig"
