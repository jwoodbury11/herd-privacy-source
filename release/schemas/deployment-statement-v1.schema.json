{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:herd:schema:deployment-statement:v1",
  "title": "Herd deployment statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "environment",
    "deployedAt",
    "manifest",
    "manifestSignature",
    "endpoints",
    "platformDeployments",
    "monitoredResources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "environment": { "enum": ["staging", "production"] },
    "deployedAt": { "type": "string", "format": "date-time" },
    "manifest": { "$ref": "release-manifest-v1.schema.json#/$defs/artifact" },
    "manifestSignature": { "$ref": "release-manifest-v1.schema.json#/$defs/artifact" },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webOrigin", "apiBaseUrl", "evaluatorUrl", "schedulerIdentity"],
      "properties": {
        "webOrigin": { "type": "string", "format": "uri" },
        "apiBaseUrl": { "type": "string", "format": "uri" },
        "evaluatorUrl": { "type": "string", "format": "uri" },
        "schedulerIdentity": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "platformDeployments": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "provider", "deploymentId", "artifactSha256"],
        "properties": {
          "component": { "enum": ["web", "ordinary-api", "evaluator", "scheduler"] },
          "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
          "deploymentId": { "type": "string", "minLength": 1, "maxLength": 300 },
          "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "monitoredResources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "sha256", "size", "mediaType"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "mediaType": { "type": "string", "minLength": 3, "maxLength": 160 }
        }
      }
    }
  }
}
