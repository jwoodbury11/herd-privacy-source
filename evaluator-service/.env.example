# Explicit environment boundary. The software QA signer additionally requires
# this to be `test`; production remains the fail-closed default.
HERD_DEPLOYMENT_PROFILE=production

# The same high-entropy token is configured on the Herd backend and this service.
HERD_EVALUATOR_TOKEN=replace-with-at-least-32-random-characters

# These release pins must exactly match the values frozen into each event policy.
HERD_EVALUATOR_KEY_ID=herd-evaluator-release-v1
HERD_EVALUATOR_MEASUREMENT=software-reference-sha384-replace-me
HERD_RELEASE_ID=herd-release-replace-me

# Secret SEC1 P-256 PEM, supplied as a multiline hosted secret. Never commit or log it.
HERD_EVALUATOR_PRIVATE_KEY_PEM="-----BEGIN EC PRIVATE KEY-----\nreplace-with-secret-key-material\n-----END EC PRIVATE KEY-----"

# A private JWK is accepted instead for local/key-management integrations. Set exactly one.
# HERD_EVALUATOR_PRIVATE_KEY_JWK={"kty":"EC","crv":"P-256","x":"replace","y":"replace","d":"replace"}

# Browser relay requests are accepted only from this exact HTTPS origin. Native
# clients do not send an Origin header and are authenticated by the capability MAC.
HERD_EVALUATOR_RELAY_ALLOWED_ORIGIN=https://replace-with-herd-web-origin.example

# Results relayed through an untrusted client are signed by a distinct P-256
# ECDSA key. The Herd backend pins this key pair's raw public point separately.
HERD_EVALUATOR_RESULT_SIGNING_KEY_ID=herd-evaluator-result-release-v1
HERD_EVALUATOR_RESULT_SIGNING_PRIVATE_KEY_JWK={"kty":"EC","crv":"P-256","x":"replace","y":"replace","d":"replace"}

# Isolated software-QA trust signer. This reference-only path is absent unless
# explicitly enabled and must never be enabled in the confidential production
# evaluator. The decryption, result, policy, and transparency purposes must all
# use distinct key IDs and distinct P-256 public points.
# HERD_SOFTWARE_QA_TRUST_SIGNER_ENABLED=false
# HERD_EVALUATOR_POLICY_SIGNING_KEY_ID=herd-qa-policy-signing-v1
# HERD_EVALUATOR_POLICY_SIGNING_PRIVATE_KEY_JWK={"kty":"EC","crv":"P-256","x":"replace","y":"replace","d":"replace"}
# HERD_EVALUATOR_TRANSPARENCY_SIGNING_KEY_ID=herd-qa-transparency-signing-v1
# HERD_EVALUATOR_TRANSPARENCY_SIGNING_PRIVATE_KEY_JWK={"kty":"EC","crv":"P-256","x":"replace","y":"replace","d":"replace"}
